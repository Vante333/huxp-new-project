# 历史品类 ePass 回归 — 合并进 env/.env.<profile>（勿提交真实 secret）
# 鉴权三件套与 Local Offer 共用 DP_EPASS_*（见 env/.env.local-offer.example）
# Apifox 对照见 api-testcases/api_tests/config/historical_epass_env.py

# DP_PROFILE=canary
# DP_BASE_URL=https://developer-sandbox.dragonpass.com/api
# DP_EPASS_PROGRAM_ID=
# DP_EPASS_CLIENT_ID=
# DP_EPASS_CLIENT_SECRET=

# ---------- 四类历史品类网点（用户指定 canary 可用值）----------
# 休息室 · 经典可用性（/v2/resources/prebookings/availability）
DP_HIST_EPASS_LOUNGE_RESOURCE_ID=N00012

# 快速通道
DP_HIST_EPASS_FASTTRACK_RESOURCE_ID=C10826

# fitness · 先 GET schedule 动态解析 optionId/时段，再 options 可用性链
DP_HIST_EPASS_FITNESS_RESOURCE_ID=GR0000308
# 可选：schedule 查询窗口（相对 UTC 今天，默认 +5 ~ +10 天；跨度最大 5 天）
# DP_HIST_EPASS_FITNESS_SCHEDULE_START_OFFSET_DAYS=5
# DP_HIST_EPASS_FITNESS_SCHEDULE_END_OFFSET_DAYS=10
# DP_HIST_EPASS_FITNESS_PREFERRED_OPTION_TYPE=1

# eSIM · options 可用性链（pytest: DP_HIST_EPASS_ESIM_* · Apifox 集合: esimResourceId / esimOptionId）
DP_HIST_EPASS_ESIM_RESOURCE_ID=GR0005901
DP_HIST_EPASS_ESIM_OPTION_ID=SKU-GS0010955

# 可选：setMeals / coupons（未配置 resourceId 时对应用例 skip）
# DP_HIST_EPASS_SETMEALS_RESOURCE_ID=
# DP_HIST_EPASS_COUPONS_RESOURCE_ID=

# 可选：eSIM usage 单 status=1 轮询（下单较慢时取消前等待）
# DP_HIST_EPASS_ESIM_STATUS_POLL_INTERVAL_SEC=3
# DP_HIST_EPASS_ESIM_STATUS_POLL_MAX_ATTEMPTS=40
