# Local Offer ePass — 复制到 env/.env.<profile> 或合并进根 .env（勿提交真实 secret）
# Apifox / Postman 变量对照见 api-testcases/api_tests/config/local_offer_epass_env.py

# ---------- 多环境切换 ----------
# DP_PROFILE=canary
# DP_BASE_URL=https://developer-sandbox.dragonpass.com/api

# ---------- 鉴权（必填）→ Apifox: programId / clientId / clientSecret ----------
DP_EPASS_PROGRAM_ID=
DP_EPASS_CLIENT_ID=
DP_EPASS_CLIENT_SECRET=
# 可选：取 token 父级 Bearer
# DP_EPASS_TOKEN_REQUEST_BEARER=

# ---------- 默认预约网点（必填，多数用例回退）→ Apifox: resourceId / optionId ----------
DP_LO_EPASS_RESOURCE_ID=
DP_LO_EPASS_OPTION_ID=

# ---------- 按券型覆盖（可选；不填则回退默认网点）----------
# voucherType=5 · url
# DP_LO_EPASS_URL_RESOURCE_ID=
# DP_LO_EPASS_URL_OPTION_ID=
# voucherType=4 · redemption_code
# DP_LO_EPASS_REDEMPTION_CODE_RESOURCE_ID=
# DP_LO_EPASS_REDEMPTION_CODE_OPTION_ID=
# voucherType=1 · card_secret
# DP_LO_EPASS_CARD_SECRET_RESOURCE_ID=
# DP_LO_EPASS_CARD_SECRET_OPTION_ID=

# ---------- 行为开关（可选）----------
# 固定预约时间（规避 500.020.009 时段不可用；格式 yyyy-MM-ddTHH:mm）
# DP_LO_EPASS_PREBOOKING_DATE=2026-06-01T10:30
# DP_LO_EPASS_USE_RESOURCE_CHAIN=1
# DP_LO_EPASS_AVAILABLE_USAGES=5
# DP_LO_EPASS_EXPIRATION_DATE=2028-12-31T23:59:59+00:00
# DP_ESIM_PREBOOKING_RESOURCE_ID=
# DP_ESIM_PREBOOKING_OPTION_ID=
# DP_LO_EPASS_NO_LO_ENTITLEMENT_EPASS_ID=

# ---------- 沙箱 redemptionUrl 有值网点 · voucherType=5（test_sandbox_redemption_url_outlets.py）----------
# DP_LO_EPASS_SANDBOX_VT5_RESOURCE_ID=
# DP_LO_EPASS_SANDBOX_VT5_OPTION_ID=
