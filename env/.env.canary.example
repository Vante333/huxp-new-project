# 开发者沙箱 + canary 路由（与 Apifox：x-version: canary 一致）
#
# 使用步骤（PowerShell）：
#   Copy-Item env\.env.canary.example env\.env.canary
#   编辑 env\.env.canary 填入真实值（该文件已被 .gitignore，勿提交）
#   指定 profile（任选其一，无需每次在终端里 export）：
#     • 根目录 .env 写一行 DP_PROFILE=canary
#     • 或 Copy-Item env\.local_profile.example env\.local_profile（首行 canary）
#   $env:PYTHONPATH = (Resolve-Path "api-testcases\2026Q2_SP1").Path
#   pytest api-testcases/2026Q2_SP1 -m "not manual" --alluredir=reports/allure-results
#
# 与 curl 头字段对应：
#   X-Program-ID          -> DP_PROGRAM_ID
#   clientId / secret     -> DP_CLIENT_ID / DP_CLIENT_SECRET
#   x-version: canary     -> DP_X_VERSION（见下）
#   Authorization: Bearer -> 若取 token 时必须带父级 JWT，填 DP_TOKEN_REQUEST_BEARER（仅 JWT 本体即可）

DP_BASE_URL=https://developer-sandbox.dragonpass.com/api
DP_PROGRAM_ID=
DP_CLIENT_ID=
DP_CLIENT_SECRET=

# 必须：否则不会发送 x-version，无法与 canary 网关行为对齐
DP_X_VERSION=canary

# 可选：POST /v2/auth/token 需额外 Bearer 时填写（与 Apifox 在 token 请求上挂父级 Bearer 一致）
# DP_TOKEN_REQUEST_BEARER=

# ePass 专用三件套（PAPI-2424 必填；与 curl 中 X-Program-ID + body clientId/secret 一致）
# DP_EPASS_PROGRAM_ID=
# DP_EPASS_CLIENT_ID=
# DP_EPASS_CLIENT_SECRET=
# 取 token 若网关要求父级 Bearer 再填（ePass 优先本项，否则回退 DP_TOKEN_REQUEST_BEARER）
# DP_EPASS_TOKEN_REQUEST_BEARER=

# 可选：默认 uuid；个别接口报 301.000.001 时可试 numeric
# DP_X_REQUEST_ID_MODE=uuid
