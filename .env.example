# 复制为项目根目录的 .env 并填写（.env 已在 .gitignore，勿提交）
#
# ========== 原有配置（Jira / Confluence 等，勿删）==========
# tools/fetch_confluence.py、tools/jira_sync.py 等会读取：
JIRA_EMAIL=
JIRA_API_TOKEN=
# 可选，jira_sync 使用：
# JIRA_BASE_URL=

# ========== Apifox MCP / CLI（在上方原有配置基础上新增）==========
APIFOX_ACCESS_TOKEN=
# Repo-first CLI 默认项目见 .apifox/settings.json（PAPI-2548 试点：346275）
# APIFOX_API_BASE_URL=https://apifox.dragonpass.com.cn

# ========== MySQL MCP（Cursor：mysql 服务器通过 .cursor/run-mysql-mcp.ps1 读取）==========
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# 可选：连接超时秒数（默认 10）
# MYSQL_CONNECT_TIMEOUT=10
# RDS 等需 SSL 时可设 CA 路径。未设置时本地 MCP 默认 ssl_disabled=true（PyMySQL，与常见 UAT 一致）。
# MYSQL_SSL_CA=
# MYSQL_SSL_DISABLED=false
# 设为 true 时恢复「表作为 resources」列举（可能与部分宿主 UI 不兼容，默认关闭）
# MYSQL_MCP_LIST_TABLES=

# ========== Membership Purchase P0（Apifox CLI · 首次会籍购买冒烟）==========
# 生成器 GeneratePostmanCollectionMembershipPurchaseP0.py 读取并注入运行时（勿提交真实值）
# MP_P0_PROGRAM_ID=
# MP_P0_CLIENT_ID=
# MP_P0_SECRET=
# 取 token 必填；详见 api-testcases/2026Q2_SP1/README.md
# DP_BASE_URL=https://developer-sandbox.dragonpass.com/api
# DP_PROGRAM_ID=
# DP_CLIENT_ID=
# DP_CLIENT_SECRET=
# 可选：同一 profile 内维护多套三件套时，设置当前运行使用的 alias。
# 例如 DP_CREDENTIAL_ALIAS=EPASS 时，会读取 DP_EPASS_PROGRAM_ID / DP_EPASS_CLIENT_ID / DP_EPASS_CLIENT_SECRET，
# 并在运行时映射为标准 DP_PROGRAM_ID / DP_CLIENT_ID / DP_CLIENT_SECRET。
# DP_CREDENTIAL_ALIAS=
# DP_CORE_PROGRAM_ID=
# DP_CORE_CLIENT_ID=
# DP_CORE_CLIENT_SECRET=
# DP_EPASS_PROGRAM_ID=
# DP_EPASS_CLIENT_ID=
# DP_EPASS_CLIENT_SECRET=
# DP_LOCALOFFER_PROGRAM_ID=
# DP_LOCALOFFER_CLIENT_ID=
# DP_LOCALOFFER_CLIENT_SECRET=
# 可选：加载 env/.env.<profile> 覆盖上述键（见 env/README.md）
# DP_PROFILE=sandbox
# 可选：选择当前 profile 下的一条 CSV 测试数据（见 api-testcases/2026Q2_SP1/testdata/<profile>/*.csv）
# 未设置时优先读各 CSV 的 default 行；未提供 CSV 时回退旧的 DP_* 变量/代码默认值
# DP_TEST_DATASET=default
# 沙箱走 canary：复制 env/.env.canary.example 为 env/.env.canary，再任选其一——
#   DP_PROFILE=canary
#   或（不写在根 .env 时）复制 env/.local_profile.example 为 env/.local_profile 首行写 canary

# ========== PAPI-2515 crossModule（api-testcases/2026Q2_SP1，见套件 README）==========
# 注册用 program（不填则回退 DP_PROGRAM_ID）
# DP_P2515_PROGRAM_ID=
# 只读结构用例 test_search_cross_module_contract_with_probe_membership 探测会籍（默认不收集该用例）
# DP_P2515_INCLUDE_PROBE=1
# DP_P2515_PROBE_MEMBERSHIP_ID=
# Postman/Apifox：S05 后若 setNextRequest 不跳到 [S06]，设 1/true 强制内联两次 search（场景中请取消勾选 [S06][S07] 以免重复）
# DP_P2515_FORCE_INLINE_TAIL=1
# Postman/Apifox：仅 [S05] 按池 plan[1..] 的 pm.sendRequest 打印入参/出参（Authorization 脱敏；超长截断）
# DP_P2515_VERBOSE_SEND_IO=1
# 注册请求体额外合并（JSON 对象字符串）
# DP_P2515_REGISTER_EXTRA_JSON=
# 附件链：单品类 update 默认值与单池 update 数量（与手工用例一致可不改）
# DP_P2515_ATTACH2_MODULE_UPDATE_JSON=
# DP_P2515_ATTACH2_UPDATE_QUANTITY=2
# DP_P2515_ATTACH2_UPDATE_TIER=2
# DP_P2515_ATTACH2_UPDATE_USAGE_RESTRICTION=1
# DP_P2515_ATTACH2_UPDATE_MODULE=
# DP_P2515_ATTACH2_POOL_QUANTITY=2
# DP_P2515_ATTACH2_POOL_PURCHASED_QTY=1
# DP_P2515_ATTACH2_RUN_DETAILS=0
# Allure 附加 entitlements 摘要附件（非控制台）
# DP_P2515_PRINT_SUMMARY_POOLS=0
# 为 1 时关闭「summary 四类指标 = pools details 跨池聚合」严格断言（缺键按 0；任池某指标为 -1 则整组该指标为 -1；默认开启严格；裁剪明细沙箱可临时打开）
# DP_P2515_RELAX_SUMMARY_POOL_SUM=0
# tc-P1-GEN-002：summary 携伴字段名与网关不一致时可覆盖（默认 allowedGuestsPerUsage / maxGuestsNextUse）
# DP_P2515_SUMMARY_GUEST_KEY_ALLOWED=
# DP_P2515_SUMMARY_GUEST_KEY_MAX=

# ========== ePass 专用（与 DP_CLIENT_ID 并存；PAPI-2424 取 token + X-Program-ID）==========
# 三件套：DP_EPASS_PROGRAM_ID（curl 的 X-Program-ID）、DP_EPASS_CLIENT_ID、DP_EPASS_CLIENT_SECRET（token 请求体）
# 父级 Bearer 可选：DP_EPASS_TOKEN_REQUEST_BEARER，未设则回退 DP_TOKEN_REQUEST_BEARER
# DP_EPASS_PROGRAM_ID=
# DP_EPASS_CLIENT_ID=
# DP_EPASS_CLIENT_SECRET=
# DP_EPASS_TOKEN_REQUEST_BEARER=

# ========== Local Offer ePass（api-testcases/api_tests · 多环境 / Apifox）==========
# 完整模板与 Apifox 变量对照：env/.env.local-offer.example、api-testcases/api_tests/config/local_offer_epass_env.py
# 鉴权（必填）：DP_EPASS_PROGRAM_ID、DP_EPASS_CLIENT_ID、DP_EPASS_CLIENT_SECRET
# 默认网点（必填）：DP_LO_EPASS_RESOURCE_ID、DP_LO_EPASS_OPTION_ID
# 按券型（可选）：DP_LO_EPASS_URL_*、DP_LO_EPASS_REDEMPTION_CODE_*、DP_LO_EPASS_CARD_SECRET_*
# Apifox 短别名（可选）：PROGRAM_ID、CLIENT_ID、CLIENT_SECRET、RESOURCE_ID、OPTION_ID

# ========== 历史品类 ePass / eSIM（api-testcases/api_tests · Apifox Esim-ePass-P0）==========
# 模板：env/.env.historical-epass.example · config/historical_epass_env.py
# eSIM 专用网点（与 DP_LO_EPASS_* 分离）：DP_HIST_EPASS_ESIM_RESOURCE_ID、DP_HIST_EPASS_ESIM_OPTION_ID
# Apifox 集合变量：esimResourceId、esimOptionId

# ========== PAPI-2424 ePasses details / MS 订单提示（api-testcases/2026Q2_SP1）==========
# 跑 test_papi_2424_* 时须配置上述 DP_EPASS_PROGRAM_ID + CLIENT_ID + SECRET；业务请求 X-Program-ID 用 DP_EPASS_PROGRAM_ID
# 可选：覆盖 V2 path（默认 /v2/orders/ePasses/details）
# DP_P2424_V2_ORDERS_EPASSES_DETAILS_PATH=
# V1 与 V2 对拍（tc-P2-EPASS-002）；不配置则 V1/V2 用例 skip
# DP_P2424_V1_ORDERS_EPASSES_DETAILS_PATH=
# tc-P1：已知非 MS 开头的 usage 订单号（不配置则该条 skip）
# DP_P2424_USAGE_ORDER_ID=
# 为 1/true 时：小写 ms 前缀与 MS 相同，均应 500.000.024；未设置则默认「仅大写 MS」命中，小写不命中
# DP_P2424_MS_PREFIX_CASE_INSENSITIVE=
