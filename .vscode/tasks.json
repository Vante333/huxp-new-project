{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Jira 同步: PAPI-2199 -> entilement.md",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/req-docs/jira_sync.py",
        "PAPI-2199",
        "-o",
        "requirements/2026Q1_SP3/entilement.md"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JIRA_EMAIL": "${env:JIRA_EMAIL}",
          "JIRA_API_TOKEN": "${env:JIRA_API_TOKEN}"
        }
      },
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Jira 同步: 使用配置文件",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/req-docs/jira_sync.py",
        "--config",
        "tools/req-docs/jira_sync_config.txt"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JIRA_EMAIL": "${env:JIRA_EMAIL}",
          "JIRA_API_TOKEN": "${env:JIRA_API_TOKEN}"
        }
      },
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Apifox CLI: SyncCheck papi_2548",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-File",
        "scripts/ApifoxRepoFirst.ps1",
        "-Action",
        "SyncCheck",
        "-Asset",
        "papi_2548"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Apifox CLI: Generate papi_2548",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-File",
        "scripts/ApifoxRepoFirst.ps1",
        "-Action",
        "Generate",
        "-Asset",
        "papi_2548"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "(冻结) PAPI-2548: Allure pytest + serve",
      "type": "shell",
      "command": "python",
      "args": ["tools/ServePapi2548Allure.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "(冻结) PAPI-2548: 仅 allure serve",
      "type": "shell",
      "command": "python",
      "args": ["tools/ServePapi2548Allure.py", "--serve-only"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ]
}
