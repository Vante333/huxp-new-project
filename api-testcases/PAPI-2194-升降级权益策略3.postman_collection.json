  "item": [
    {
      "name": "前置步骤-获取Token",
      "request": {
        "method": "POST",
        "url": "{{BASE_URL}}/v2/auth/token",
        "header": [
          {
            "key": "X-Program-ID",
            "value": "{{Program-ID}}"
          },
          {
            "key": "X-Request-ID",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"clientId\": \"{{clientId}}\",\n    \"secret\": \"{{secret}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('获取Token成功', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.code).to.eql(0);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "if (jsonData.code === 0 && jsonData.data) {",
              "    pm.collectionVariables.set('access_token', jsonData.data.accessToken);",
              "    pm.collectionVariables.set('token_type', jsonData.data.tokenType || 'Bearer');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "策略枚举与租户限制",
      "item": [
        {
          "name": "正向场景验证",
          "item": [
            {
              "name": "tc-P1-STGY-001 Revolut租户使用策略3-正常受理",
              "request": {
                "method": "POST",
                "url": "{{BASE_URL}}/v2/memberships/programChange",
                "header": [
                  {
                    "key": "X-Program-ID",
                    "value": "{{Program-ID}}"
                  },
                  {
                    "key": "X-Request-ID",
                    "value": "{{$guid}}"
                  },
                  {
                    "key": "Authorization",
                    "value": "{{token_type}} {{access_token}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"membershipId\": \"{{membershipId}}\",\n    \"programId\": \"{{programId}}\",\n    \"targetProgramId\": \"{{targetProgramId}}\",\n    \"entitlementOptions\": {\n        \"strategy\": 3\n    },\n    \"validityOptions\": {\n        \"strategy\": 1\n    }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "tc-P1-STGY-001：Revolut 租户使用 entitlementStrategy=3 调用 Change Membership Program API，接口正常受理\n\n验证点：\n- HTTP 状态码为 200\n- 接口正常受理并触发策略 3 的新权益迁移逻辑\n- 响应中迁移策略类型记录为 3"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// tc-P1-STGY-001: Revolut租户使用策略3-正常受理",
                      "",
                      "pm.test('HTTP状态码为200', function() {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test('接口正常受理-code为0', function() {",
                      "    var jsonData = pm.response.json();",
                      "    pm.expect(jsonData.code).to.eql(0);",
                      "});",
                      "",
                      "pm.test('响应包含正确的membershipId', function() {",
                      "    var jsonData = pm.response.json();",
                      "    pm.expect(jsonData.data).to.have.property('membershipId');",
                      "});",
                      "",
                      "pm.test('响应包含正确的programId(目标)', function() {",
                      "    var jsonData = pm.response.json();",
                      "    var targetProgramId = pm.collectionVariables.get('targetProgramId');",
                      "    pm.expect(jsonData.data.programId).to.eql(targetProgramId);",
                      "});",
                      "",
                      "pm.test('响应包含previousProgramId(源)', function() {",
                      "    var jsonData = pm.response.json();",
                      "    var programId = pm.collectionVariables.get('programId');",
                      "    pm.expect(jsonData.data.previousProgramId).to.eql(programId);",
                      "});",
                      "",
                      "// 返回中不包含中文检查",
                      "pm.test('返回中不包含中文', function() {",
                      "    var res = pm.response.text();",
                      "    var hasChinese = /[\\u4e00-\\u9fa5]/.test(res);",
                      "    pm.expect(hasChinese).to.equal(false);",
                      "});"
                    ]
                  }
                }
              ]
            },
