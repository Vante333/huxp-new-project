                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// tc-P2-STGY-005: 非Revolut租户使用策略3-拒绝",
                      "",
                      "pm.test('非Revolut租户使用策略3被拒绝', function() {",
                      "    var jsonData = pm.response.json();",
                      "    pm.expect(jsonData.code).to.eql(-1);",
                      "});",
                      "",
                      "pm.test('返回明确的错误信息', function() {",
                      "    var jsonData = pm.response.json();",
                      "    pm.expect(jsonData).to.have.property('msg');",
                      "    pm.expect(jsonData.msg).to.not.be.empty;",
                      "});",
                      "",
                      "pm.test('返回错误码', function() {",
                      "    var jsonData = pm.response.json();",
                      "    pm.expect(jsonData).to.have.property('errCode');",
                      "    // 预期错误码格式: 400.030.xxx",
                      "    pm.expect(jsonData.errCode).to.match(/^400\\.030\\./);",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
