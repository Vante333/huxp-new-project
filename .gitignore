# 环境变量与敏感信息（切勿提交）
.env
.env.local
.env.*.local

# API 测试 profile（保留 env/.env.example 与 env/.env.*.example）
env/.env.*
!env/.env.example
!env/.env.*.example
# 本地默认 profile 名（见 api-testcases conftest：无 DP_PROFILE 时读取首行）
env/.local_profile

# 测试报告与 Allure 结果（本地生成，勿提交）
reports/
apifox-reports/

# Postman 流水线中间件（Apifox 导入包等；正本在 generators/，集合在 collections/）
api-testcases/api_tests/postman/generated/
api-testcases/api_tests/apifox-cli/generated/

# Python cache artifacts
.pytest_cache/
__pycache__/
*.pyc
*.pyo
*.pyd

# 本地密钥 / 一次性调试（不要进 Git）
**/*.postman_environment.json
tools/q3-sp4-xmind-apifox/smoke_pre.js
tools/q3-sp4-xmind-apifox/smoke_pay.js
tools/q3-sp4-xmind-apifox/smoke-*.txt
tools/q3-sp4-xmind-apifox/smoke-*.json
tools/q3-sp4-xmind-apifox/generated/*
!tools/q3-sp4-xmind-apifox/generated/pushed-ids.json
tools/sso-links-q3-sp4/run-results/
.cursor/skills/api-test-datasets/datasets/
.cursor/skills/api-test-datasets/catalog.md
