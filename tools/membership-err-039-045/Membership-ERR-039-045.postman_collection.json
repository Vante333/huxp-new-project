    {
      "name": "00 Auth",
      "item": [
        {
          "name": "会籍鉴权",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Auth HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Auth code=0', function () { pm.expect(json.code).to.eql(0); });",
                  "const token = json && json.data && (json.data.accessToken || json.data.access_token);",
                  "pm.test('写出 access_token', function () { pm.expect(token).to.be.ok; });",
                  "if (token) { pm.environment.set('access_token', token); }",
                  "const pid = pm.variables.get('ProgramID') || pm.environment.get('Program-ID') || '2032786406298624';",
                  "pm.environment.set('Program-ID', pid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-version", "value": "{{x-version}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"secret\": \"{{secret}}\"\n}"
            },
            "url": "{{baseUrl}}/v2/auth/token"
          }
        }
      ]
    },
    {
