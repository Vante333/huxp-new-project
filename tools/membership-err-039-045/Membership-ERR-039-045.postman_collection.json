    {
      "name": "02 ERR-039 Preview",
      "item": [
        {
          "name": "039 商品B+autoRenewal=true",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const err = String(json.errCode || '');",
                  "const msg = String(json.msg || '');",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('code=-1', function () { pm.expect(json.code).to.eql(-1); });",
                  "pm.test('不得仍是旧码 500.020.030', function () { pm.expect(err).to.not.eql('500.020.030'); });",
                  "pm.test('文案不得含 current local time', function () { pm.expect(msg.toLowerCase()).to.not.include('current local time'); });",
                  "pm.test('039 或 042（码文案成对）', function () {",
                  "  if (err === '500.030.039') {",
                  "    pm.expect(msg).to.eql('Unable to preview the order at the moment. Please try again later.');",
                  "  } else if (err === '500.030.042') {",
                  "    pm.expect(msg).to.eql('Auto-renewal is not supported for this program.');",
                  "  } else {",
                  "    pm.expect.fail('实际 errCode=' + err + ' msg=' + msg + '，期望 500.030.039 或 500.030.042');",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "X-Program-ID", "value": "{{Program-ID}}" },
              { "key": "x-version", "value": "{{x-version}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appId\": 1,\n  \"autoRenewal\": true,\n  \"profile\": {\n    \"email\": \"2484268151@qq.COM\",\n    \"clientUserId\": \"{{$string.uuid}}\",\n    \"callingCode\": \"86\",\n    \"phoneNumber\": \"15838657142\"\n  }\n}"
            },
            "url": "{{baseUrl}}/v2/orders/memberships/purchase/preview"
          }
        }
      ]
