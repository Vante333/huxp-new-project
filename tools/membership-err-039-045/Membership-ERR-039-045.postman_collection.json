              { "key": "X-Program-ID", "value": "{{Program-ID}}" },
              { "key": "x-version", "value": "{{x-version}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appId\": 1,\n  \"autoRenewal\": false,\n  \"profile\": {\n    \"email\": \"2484268151@qq.COM\",\n    \"clientUserId\": \"{{$string.uuid}}\",\n    \"callingCode\": \"86\",\n    \"phoneNumber\": \"15838657142\"\n  }\n}"
