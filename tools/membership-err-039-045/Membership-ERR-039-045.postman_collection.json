                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('code=0 对照成功', function () { pm.expect(json.code).to.eql(0); });",
                  "pm.test('不是 039~045', function () {",
                  "  pm.expect(String(json.errCode || '')).to.not.match(/^500\\.030\\.04[0-5]$|^500\\.030\\.039$/);",
                  "});",
                  "const extra = json.data && json.data.extra;",
                  "const profile = extra && extra.profile;",
                  "if (profile) {",
                  "  pm.test('email 回显', function () { pm.expect(String(profile.email)).to.eql('2484268151@qq.COM'); });",
                  "  if (profile.callingCode != null) {",
                  "    pm.test('callingCode=86', function () { pm.expect(String(profile.callingCode)).to.eql('86'); });",
                  "  }",
                  "  if (profile.phoneNumber != null) {",
                  "    pm.test('phoneNumber 回显', function () { pm.expect(String(profile.phoneNumber)).to.eql('15838657142'); });",
                  "  }",
                  "}"
                ]
