enerate a voucher in the application. This could be a QR Code, a barcode, or a URL of an image, depending on the voucher type.\"\n                              },\n                              \"voucherType\": {\n                                \"type\": \"integer\",\n                                \"description\": \"Specifies the type of products, e.g. \\\"QRCODE\\\", \\\"BARCODE\\\" or \\\"IMAGE\\\".\",\n                                \"enum\": [\n                                  1,\n                                  2,\n                                  3,\n                                  4\n                                ],\n                                \"examples\": [\n                                  1\n                                ]\n                              }\n                            },\n                            \"required\": [\n                              \"voucher\",\n                              \"voucherType\"\n                            ]\n                          }\n                        },\n                        \"prebookingRequiredInfo\": {\n                          \"type\": \"object\",\n                          \"properties\": {\n                            \"firstName\": {\n                              \"type\": [\n                                \"string\",\n                                \"null\"\n                              ],\n                              \"description\": \"User's first name. It should match the name on the user's travel document.\",\n                              \"pattern\": \"^[A-Za-z]+$\",\n                              \"maxLength\": 50,\n                              \"minLength\": 1,\n                              \"examples\": [\n                                \"DragonPass\"\n                              ]\n                            },\n                            \"lastName\": {\n                              \"type\": [\n                                \"string\",\n      