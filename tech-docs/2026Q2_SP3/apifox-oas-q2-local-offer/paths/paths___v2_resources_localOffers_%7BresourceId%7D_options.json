"{\n  \"get\": {\n    \"summary\": \"Retrieve Local Offer Resouces Options\",\n    \"deprecated\": false,\n    \"description\": \"This API allows corporate clients to retrieve a list of available resource options. For example, clients can use it to fetch the offer list associated with a specific resource.\",\n    \"tags\": [],\n    \"parameters\": [\n      {\n        \"name\": \"resourceId\",\n        \"in\": \"path\",\n        \"description\": \"Unique ID for the DragonPass resources.\",\n        \"required\": true,\n        \"example\": \"N00001\",\n        \"schema\": {\n          \"type\": \"string\"\n        }\n      },\n      {\n        \"name\": \"duration\",\n        \"in\": \"query\",\n        \"description\": \"Specifies the duration for which the eSIM data package remains active after activation.\",\n        \"required\": false,\n        \"example\": 7,\n        \"schema\": {\n          \"type\": \"integer\"\n        }\n      },\n      {\n        \"name\": \"pageSize\",\n        \"in\": \"query\",\n        \"description\": \"The number of records returned per page.\",\n        \"required\": false,\n        \"example\": 10,\n        \"schema\": {\n          \"type\": \"integer\"\n        }\n      },\n      {\n        \"name\": \"pageNumber\",\n        \"in\": \"query\",\n        \"description\": \"The current page number, starting from 1.\",\n        \"required\": false,\n        \"example\": 1,\n        \"schema\": {\n          \"type\": \"integer\"\n        }\n      },\n      {\n        \"name\": \"language\",\n        \"in\": \"query\",\n        \"description\": \"Specifies the language of the response in IETF language tag format, such as 'en-US'.\",\n        \"required\": false,\n        \"example\": \"en-US\",\n        \"schema\": {\n          \"type\": \"string\"\n        }\n      },\n      {\n        \"name\": \"X-Program-ID\",\n        \"in\": \"header\",\n        \"description\": \"Unique identifier of the program. Assigned by DragonPass when a new program is onboarded.\",\n        \"required\": true,\n        \"example\": \"{{Program-ID}}\",\n        \"schema\": {\n          \"type\": \"string\",\n          \"examples\": [\n            \"1876920048220766208\"\n          ],\n          \"default\": \"{{Program-ID}}\"\n        }\n      },\n      {\n        \"name\": \"X-Request-ID\",\n        \"in\": \"header\",\n        \"description\": \"DragonPass server uses this header along with the request body, to identify subsequent retries of the same request. \\nThis key header will be verified for all POST requests, and the API client must include an idempotency key header with a unique value in each request.\\nIt is recommended to generate a universally unique identifier (UUID) in compliance with RFC 4122.\",\n        \"required\": true,\n        \"example\": \"{{$string.uuid}}\",\n        \"schema\": {\n          \"type\": \"string\",\n          \"minLength\": 1,\n          \"maxLength\": 50,\n          \"format\": \"uuid\",\n          \"examples\": [\n            \"506a4dad-9ca5-42d5-b151-7bf81ef0d983\"\n          ],\n          \"default\": \"{{$string.uuid}}\"\n        }\n      },\n      {\n        \"name\": \"Authorization\",\n        \"in\": \"header\",\n        \"description\": \"Authorization Token\",\n        \"required\": true,\n        \"example\": \"{{token_type}} {{access_token}}\",\n        \"schema\": {\n          \"type\": \"string\",\n          \"default\": \"{{token_type}} {{access_token}}\"\n        }\n      },\n      {\n        \"name\": \"Content-Type\",\n        \"in\": \"header\",\n        \"description\": \"\",\n        \"required\": true,\n        \"example\": \"application/json\",\n        \"schema\": {\n          \"type\": \"string\"\n        }\n      }\n    ],\n    \"responses\": {\n      \"200\": {\n        \"description\": \"\",\n        \"content\": {\n          \"application/json\": {\n            \"schema\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"code\": {\n                  \"type\": \"integer\",\n                  \"enum\": [\n                    0,\n                    -1\n                  ],\n                  \"examples\": [\n                    0\n                  ],\n                  \"description\": \"Status code of the API response.\"\n                },\n                \"data\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"pagination\": {\n                      \"type\": \"object\",\n                      \"properties\": {\n                        \"pageSize\": {\n                          \"type\": \"integer\",\n                          \"description\": \"The number of records returned per page.\",\n                          \"minimum\": 1,\n                          \"maximum\": 100,\n                          \"examples\": [\n                            10\n                          ]\n                        },\n                        \"pageNumber\": {\n                          \"type\": \"integer\",\n                          \"description\": \"The current page number, starting from 1.\",\n                          \"minimum\": 1,\n                          \"maximum\": 100,\n                          \"exclusiveMaximum\": 100,\n                          \"examples\": [\n                            1\n                          ]\n                        },\n                        \"totalNumber\": {\n                          \"type\": \"integer\",\n                          \"examples\": [\n                            100\n                          ],\n                          \"description\": \"The total number of records across all pages.\"\n                        }\n                      },\n                      \"required\": [\n                        \"totalNumber\",\n                        \"pageSize\",\n                        \"pageNumber\"\n                      ]\n                    },\n                    \"resourceId\": {\n                      \"type\": \"string\",\n                      \"description\": \"Unique ID for the DragonPass resources.\",\n                      \"examples\": [\n                        \"N00001\"\n                      ]\n                    },\n                    \"resourceName\": {\n                      \"type\": \"string\",\n                      \"description\": \"Name of the DragonPass resources, such as the lounge names and restaurant names.\",\n                      \"examples\": [\n                        \"DragonPass Lounge\"\n                      ]\n                    },\n                    \"optionList\": {\n                      \"type\": \"array\",\n                      \"items\": {\n                        \"type\": \"object\",\n                        \"properties\": {\n                          \"optionId\": {\n                            \"type\": \"string\",\n                            \"description\": \"Unique identifier for a specific option offered under a particular resource(e.g., class ID, data package ID, reservation ID).\",\n                            \"examples\": [\n                              \"F00001-01\"\n                            ]\n                          },\n                          \"optionName\": {\n                            \"type\": \"string\",\n                            \"description\": \"The name of a specific option offered under a particular resource (e.g., \\\"30 USD Coupon\\\", \\\"Set Meal\\\", \\\"Day Pass\\\").\",\n                            \"examples\": [\n                              \"Day Pass\",\n                              \"30 USD Coupon\"\n                            ]\n                          },\n                          \"marketingTag\": {\n                            \"type\": \"array\",\n                            \"items\": {\n                              \"type\": \"integer\",\n                              \"enum\": [\n                                1,\n                                2,\n                                3,\n                                4\n                              ],\n                              \"examples\": [\n                                1\n                              ]\n                            },\n                            \"description\": \"A label used to highlight the marketing promotion associated with the product or offer (e.g. “Buy X Get Y”). This field is for display and tagging purposes only and does not affect pricing logic.\"\n                          },\n                          \"validity\": {\n                            \"anyOf\": [\n                              {\n                                \"type\": \"object\",\n                                \"properties\": {\n                                  \"type\": {\n                                    \"type\": \"integer\",\n                                    \"description\": \"Indicates how the validity period is defined.\",\n                                    \"examples\": [\n                                      1\n                                    ],\n                                    \"enum\": [\n                                      1,\n                                      2,\n                                      3\n                                    ]\n                                  },\n                                  \"startTime\": {\n                                    \"type\": \"string\",\n                                    \"examples\": [\n                                      \"2026-04-01T00:00:00+00:00\"\n                                    ],\n                                    \"description\": \"Start date and time of the validity period (ISO 8601 format).\"\n                                  },\n                                  \"endTime\": {\n                                    \"type\": \"string\",\n                                    \"examples\": [\n                                      \"2026-04-02T00:00:00+00:00\"\n                                    ],\n                                    \"description\": \"End date and time of the validity period (ISO 8601 format).\"\n                                  }\n                                },\n                                \"required\": [\n                                  \"type\",\n                                  \"startTime\",\n                                  \"endTime\"\n                                ],\n                                \"description\": \"Fixed date\"\n                              },\n                              {\n                                \"type\": \"object\",\n                                \"properties\": {\n                                  \"type\": {\n                                    \"type\": \"integer\",\n                                    \"description\": \"Indicates how the validity period is defined.\",\n                                    \"examples\": [\n                                      2\n                                    ],\n                                    \"enum\": [\n                                      1,\n                                      2,\n                                      3\n                                    ]\n                                  },\n                                  \"value\": {\n                                    \"type\": \"integer\",\n                                    \"description\": \"Duration value of the validity period.\"\n                                  },\n                                  \"unit\": {\n                                    \"type\": \"string\",\n                                    \"examples\": [\n                                      \"DAY\"\n                                    ],\n                                    \"enum\": [\n                                      \"DAY\",\n                                      \"MONTH\",\n                                      \"YEAR\"\n                                    ],\n                                    \"description\": \"Unit of the duration. Supported values: DAY, MONTH, YEAR.\"\n                                  }\n                                },\n                                \"required\": [\n                                  \"type\",\n                                  \"value\",\n                                  \"unit\"\n                                ],\n                                \"description\": \"Relative duration\"\n                              },\n                              {\n                                \"type\": \"object\",\n                                \"properties\": {\n                                  \"type\": {\n                                    \"type\": \"integer\",\n                                    \"description\": \"Indicates how the validity period is defined.\",\n                                    \"examples\": [\n                                      3\n                                    ],\n                                    \"enum\": [\n                                      1,\n                                      2,\n                                      3\n                                    ]\n                                  }\n                                },\n                                \"required\": [\n                                  \"type\"\n                                ],\n                                \"description\": \"Dynamic\"\n                              }\n                            ],\n                            \"description\": \"Defines the validity period of the offers, either as a fixed date range or as a relative duration starting from a specific trigger point (e.g. issuance or activation).\"\n                          }\n                        },\n                        \"required\": [\n                          \"optionId\",\n                          \"optionName\",\n                          \"marketingTag\",\n                          \"validity\"\n                        ]\n                      },\n                      \"description\": \"Contains detailed information about the data package bound to the eSIM.\"\n                    }\n                  },\n                  \"required\": [\n                    \"pagination\",\n                    \"resourceId\",\n                    \"resourceName\",\n                    \"optionList\"\n                  ]\n                }\n              },\n              \"required\": [\n                \"code\",\n                \"data\"\n              ]\n            },\n            \"examples\": {\n              \"1\": {\n                \"summary\": \"Success\",\n                \"value\": {\n                  \"code\": 0,\n                  \"data\": {\n                    \"pagination\": {\n                      \"pageSize\": 10,\n                      \"pageNumber\": 1,\n                      \"totalNumber\": 2\n                    },\n                    \"resourceId\": \"LO00001\",\n                    \"resourceName\": \"DragonPass Club\",\n                    \"optionList\": [\n                      {\n                        \"optionId\": \"LO00001-01\",\n                        \"optionName\": \"5% discount\",\n                        \"marketingTag\": [\n                          \"2\"\n                        ],\n                        \"validity\": {\n                          \"type\": 1,\n                          \"startTime\": \"2026-04-01T00:00:00+00:00\",\n                          \"endTime\": \"2027-04-01T00:00:00+00:00\"\n                        }\n                      },\n                      {\n                        \"optionId\": \"LO00001-02\",\n                        \"optionName\": \"free drink\",\n                        \"marketingTag\": [\n                          \"1\"\n                        ],\n                        \"validity\": {\n                          \"type\": 2,\n                          \"value\": 30,\n                          \"unit\": \"DAY\"\n                        }\n                      }\n                    ]\n                  }\n                }\n              },\n              \"2\": {\n                \"summary\": \"Exception\",\n                \"value\": {\n                  \"code\": -1,\n                  \"msg\": \"Sorry, we’re unable to retrieve the list at the moment. Please try again later.\",\n                  \"errCode\": \"500.020.016\"\n                }\n              }\n            }\n          }\n        },\n        \"headers\": {}\n      }\n    },\n    \"security\": []\n  }\n}"