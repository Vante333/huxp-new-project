"{\n  \"post\": {\n    \"summary\": \"Retrieve Prebooking Option Pricing Information\",\n    \"deprecated\": false,\n    \"description\": \"\",\n    \"tags\": [],\n    \"parameters\": [\n      {\n        \"name\": \"X-Program-ID\",\n        \"in\": \"header\",\n        \"description\": \"Unique identifier of the program. Assigned by DragonPass when a new program is onboarded.\",\n        \"required\": true,\n        \"example\": \"{{Program-ID}}\",\n        \"schema\": {\n          \"type\": \"string\",\n          \"examples\": [\n            \"1876920048220766208\"\n          ],\n          \"default\": \"{{Program-ID}}\"\n        }\n      },\n      {\n        \"name\": \"X-Request-ID\",\n        \"in\": \"header\",\n        \"description\": \"DragonPass server uses this header along with the request body, to identify subsequent retries of the same request. \\nThis key header will be verified for all POST requests, and the API client must include an idempotency key header with a unique value in each request.\\nIt is recommended to generate a universally unique identifier (UUID) in compliance with RFC 4122.\",\n        \"required\": true,\n        \"example\": \"{{$string.uuid}}\",\n        \"schema\": {\n          \"type\": \"string\",\n          \"minLength\": 1,\n          \"maxLength\": 50,\n          \"format\": \"uuid\",\n          \"examples\": [\n            \"506a4dad-9ca5-42d5-b151-7bf81ef0d983\"\n          ],\n          \"default\": \"{{$string.uuid}}\"\n        }\n      },\n      {\n        \"name\": \"Authorization\",\n        \"in\": \"header\",\n        \"description\": \"Authorization Token\",\n        \"required\": true,\n        \"example\": \"{{token_type}} {{access_token}}\",\n        \"schema\": {\n          \"type\": \"string\",\n          \"default\": \"{{token_type}} {{access_token}}\"\n        }\n      },\n      {\n        \"name\": \"Content-Type\",\n        \"in\": \"header\",\n        \"description\": \"\",\n        \"required\": true,\n  