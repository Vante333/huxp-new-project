          \"Manchester Airport\"\n                                ]\n                              },\n                              \"city\": {\n                                \"type\": [\n                                  \"string\",\n                                  \"null\"\n                                ],\n                                \"description\": \"City\",\n                                \"examples\": [\n                                  \"Manchester\"\n                                ]\n                              },\n                              \"countryOrRegion\": {\n                                \"type\": [\n                                  \"string\",\n                                  \"null\"\n                                ],\n                                \"description\": \"Two-letter country/region codes defined in ISO 3166-1, e.g. \\\"UK\\\", \\\"CN\\\".\",\n                                \"pattern\": \"^[A-Z]+\",\n                                \"maxLength\": 2,\n                                \"minLength\": 2,\n                                \"examples\": [\n                                  \"GB\"\n                                ]\n                              }\n                            },\n                            \"required\": [\n                              \"optionId\",\n                              \"optionName\",\n                              \"transportHubId\",\n                              \"transportHubName\",\n                              \"city\",\n                              \"countryOrRegion\"\n                            ]\n                          }\n                        },\n                        \"required\": [\n                          \"extra\",\n                          \"orderId\",\n                          \"status\",\n                          \"usedUsages\",\n                          \"module\",\n                          \"category\",\n                          \"orderCreatedDate\",\n                          \"resourceId\",\n                          \"resourceName\",\n                          \"image\"\n                        ]\n                      }\n                    }\n                  },\n                  \"required\": [\n                    \"orders\",\n                    \"pagination\"\n                  ]\n                }\n              },\n              \"required\": [\n                \"code\",\n                \"data\"\n              ]\n            },\n            \"examples\": {\n              \"1\": {\n                \"summary\": \"Success\",\n                \"value\": {\n                  \"code\": 0,\n                  \"data\": {\n                    \"Pagination\": {\n                      \"pageSize\": 10,\n                      \"pageNumber\": 1,\n                      \"totalNumber\": 3\n                    },\n                    \"orders\": [\n                      {\n                        \"orderId\": \"DP00000000000001\",\n                        \"status\": 1,\n                        \"usedUsages\": 1,\n                        \"module\": 1,\n                        \"category\": 1,\n                        \"orderCreatedDate\": \"2024-12-01T00:00:00+00:00\",\n                        \"resourceId\": \"N00001\",\n                        \"resourceName\": \"DragonPass Lounge\",\n                        \"image\": \"https://image.dragonpass.com/uploadFile/images/cover.png\",\n                        \"extra\": {\n                          \"optionId\": null,\n                          \"optionName\": null,\n                          \"transportHubName\": \"Manchester Airport\",\n                          \"transportHubId\": \"A00001\",\n                          \"city\": \"Manchester\",\n                          \"countryOrRegion\": \"GB\"\n                        }\n                      },\n                      {\n                        \"orderId\": \"DP00000000000002\",\n               