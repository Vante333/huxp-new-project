: null,\n                    \"extra\": {\n                      \"ePassId\": \"1788000066668888\",\n                      \"ePassStatus\": 1,\n                      \"firstName\": \"DragonPass\",\n                      \"lastName\": \"DragonPass\",\n                      \"activationDate\": \"2028-10-31T23:59:59+00:00\",\n                      \"expirationDate\": \"2028-12-31T23:59:59+00:00\",\n                      \"availableUsages\": 0,\n                      \"usedUsages\": 1,\n                      \"allowedResources\": {\n                        \"resourceIds\": [\n                          \"R00001\"\n                        ]\n                      }\n                    }\n                  }\n                }\n              },\n              \"4\": {\n                \"summary\": \"Success\",\n                \"value\": {\n                  \"code\": 0,\n                  \"data\": {\n                    \"status\": 2,\n                    \"module\": 4,\n                    \"category\": 1,\n                    \"clientUserId\": \"3EF5D065-76F8-4D3E-801A-B329D15F461A\",\n                    \"orderId\": \"DP00000000000001\",\n                    \"orderCreatedDate\": \"2024-12-31T00:00:00+00:00\",\n                    \"orderCancelledDate\": null,\n                    \"extra\": {\n                      \"ePassId\": \"1788000066668888\",\n                      \"ePassStatus\": 1,\n                      \"firstName\": \"DragonPass\",\n                      \"lastName\": \"DragonPass\",\n                      \"activationDate\": \"2028-10-31T23:59:59+00:00\",\n                      \"expirationDate\": \"2028-12-31T23:59:59+00:00\",\n                      \"availableUsages\": 0,\n                      \"usedUsages\": 1,\n                      \"allowedResources\": {\n                        \"resourceIds\": [\n                          \"R00001\"\n                        ]\n                      }\n                    }\n                  }\n                }\n              },\n              \"5\": {\n                \"summary\": \"Success\",\n                \"value\": {\n                  \"code\": 0,\n                  \"data\": {\n                    \"status\": 2,\n                    \"module\": 7,\n                    \"category\": 2,\n                    \"clientUserId\": \"3EF5D065-76F8-4D3E-801A-B329D15F461A\",\n                    \"orderId\": \"DP00000000000001\",\n                    \"orderCreatedDate\": \"2024-12-31T00:00:00+00:00\",\n                    \"orderCancelledDate\": null,\n                    \"extra\": {\n                      \"ePassId\": \"1788000066668888\",\n                      \"ePassStatus\": 1,\n                      \"firstName\": \"DragonPass\",\n                      \"lastName\": \"DragonPass\",\n                      \"activationDate\": \"2028-10-31T23:59:59+00:00\",\n                      \"expirationDate\": \"2028-12-31T23:59:59+00:00\",\n                      \"availableUsages\": 0,\n                      \"usedUsages\": 1,\n                      \"allowedResources\": {\n                        \"resourceIds\": [\n                          \"F00001\"\n                        ]\n                      }\n                    }\n                  }\n                }\n              },\n              \"6\": {\n                \"summary\": \"Success\",\n                \"value\": {\n                  \"code\": 0,\n                  \"data\": {\n                    \"status\": 2,\n                    \"module\": 8,\n                    \"category\": 1,\n                    \"clientUserId\": \"3EF5D065-76F8-4D3E-801A-B329D15F461A\",\n                    \"orderId\": \"DP00000000000001\",\n                    \"orderCreatedDate\": \"2024-12-31T00:00:00+00:00\",\n                    \"orderCancelledDate\": null,\n                    \"extra\": {\n                      \"ePassId\": \"1788000066668888\",\n                      \"firstName\": \"DragonPass\",\n                      \"lastName\": \"DragonPass\",\n                      \"activationDate\": \"2028-10-31T23:59:59+00:00\",\n                      \"expirationDate\": \"2028-12-31T23:59:59+00:00\",\n                      \"availableUsages\": 0,\n                      \"usedUsages\": 1,\n                      \"allowedResources\": {\n                        \"resourceIds\": [\n                          \"E00001\"\n                        ]\n                      }\n                    }\n                  }\n                }\n              },\n              \"7\": {\n                \"summary\": \"Exception\",\n                \"value\": {\n                  \"code\": -1,\n                  \"msg\": \"Sorry, we’re unable to retrieve the order details at the moment. Please try again later.\",\n                  \"errCode\": \"500.000.006\"\n                }\n              },\n              \"8\": {\n                \"summary\": \"Success\",\n                \"value\": {\n                  \"code\": 0,\n                  \"data\": {\n                    \"status\": 2,\n                    \"module\": 0,\n                    \"category\": 1,\n                    \"clientUserId\": \"3EF5D065-76F8-4D3E-801A-B329D15F461A\",\n                    \"orderId\": \"DP00000000000001\",\n                    \"orderCreatedDate\": \"2024-12-31T00:00:00+00:00\",\n                    \"orderCancelledDate\": null,\n                    \"extra\": {\n                      \"ePassId\": \"1788000066668888\",\n                      \"ePassStatus\": 0,\n                      \"firstName\": \"DragonPass\",\n                      \"lastName\": \"DragonPass\",\n                      \"activationDate\": \"2028-10-31T23:59:59+00:00\",\n                      \"expirationDate\": \"2028-12-31T23:59:59+00:00\",\n                      \"availableUsages\": 1,\n                      \"usedUsages\": 0,\n                      \"allowedResources\": {\n                        \"resourceIds\": []\n                      },\n                      \"allowedModules\": [\n                        1,\n                        3,\n                        4\n                      ]\n                    }\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"headers\": {}\n      }\n    },\n    \"security\": [\n      {\n        \"jwt\": []\n      }\n    ]\n  }\n}"