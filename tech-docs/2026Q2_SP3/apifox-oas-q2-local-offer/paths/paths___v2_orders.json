"{\n  \"patch\": {\n    \"summary\": \"Cancel an Order\",\n    \"deprecated\": false,\n    \"description\": \"This API enables corporate clients to cancel an existing order.\",\n    \"tags\": [],\n    \"parameters\": [\n      {\n        \"name\": \"X-Program-ID\",\n        \"in\": \"header\",\n        \"description\": \"Unique identifier of the program. Assigned by DragonPass when a new program is onboarded.\",\n        \"required\": true,\n        \"example\": \"{{Program-ID}}\",\n        \"schema\": {\n          \"type\": \"string\",\n          \"examples\": [\n            \"1876920048220766208\"\n          ],\n          \"default\": \"{{Program-ID}}\"\n        }\n      },\n      {\n        \"name\": \"X-Request-ID\",\n        \"in\": \"header\",\n        \"description\": \"DragonPass server uses this header along with the request body, to identify subsequent retries of the same request. \\nThis key header will be verified for all POST requests, and the API client must include an idempotency key header with a unique value in each request.\\nIt is recommended to generate a universally unique identifier (UUID) in compliance with RFC 4122.\",\n        \"required\": true,\n        \"example\": \"{{$string.uuid}}\",\n        \"schema\": {\n          \"type\": \"string\",\n          \"minLength\": 1,\n          \"maxLength\": 50,\n          \"format\": \"uuid\",\n          \"examples\": [\n            \"506a4dad-9ca5-42d5-b151-7bf81ef0d983\"\n          ],\n          \"default\": \"{{$string.uuid}}\"\n        }\n      },\n      {\n        \"name\": \"Authorization\",\n        \"in\": \"header\",\n        \"description\": \"Authorization Token\",\n        \"required\": true,\n        \"example\": \"{{token_type}} {{access_token}}\",\n        \"schema\": {\n          \"type\": \"string\",\n          \"default\": \"{{token_type}} {{access_token}}\"\n        }\n      },\n      {\n        \"name\": \"Content-Type\",\n        \"in\": \"header\",\n        \"description\": \"\",\n        \"required\": true,\n        \"example\": \"application/json\",\n        \"schema\": {\n          \"type\": \"string\"\n        }\n      }\n    ],\n    \"requestBody\": {\n      \"content\": {\n        \"application/json\": {\n          \"schema\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"status\": {\n                \"type\": \"integer\",\n                \"description\": \"Order status, 3 - \\\"CANLLED\\\".\",\n                \"enum\": [\n                  3\n                ],\n                \"examples\": [\n                  3\n                ]\n              },\n              \"orderId\": {\n                \"type\": \"string\",\n                \"description\": \"Unique identifier of the order. Assigned by DragonPass when a new order was created. Can be used to retrieve order details or cancel the orders.\",\n                \"examples\": [\n                  \"DP00000000000001\"\n                ]\n              }\n            },\n            \"required\": [\n              \"status\",\n              \"orderId\"\n            ]\n          },\n          \"example\": {\n            \"status\": 3,\n            \"orderId\": \"DP00000000000001\"\n          }\n        }\n      }\n    },\n    \"responses\": {\n      \"200\": {\n        \"description\": \"\",\n        \"content\": {\n          \"application/json\": {\n            \"schema\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"code\": {\n                  \"type\": \"integer\",\n                  \"enum\": [\n                    0,\n                    -1\n                  ],\n                  \"examples\": [\n                    0\n                  ],\n                  \"description\": \"Status code of the API response.\"\n                },\n                \"msg\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"required\": [\n                \"code\",\n                \"msg\"\n              ]\n            },\n            \"examples\": {\n              \"1\": {\n                \"summary\": \"Success\",\n                \"value\": {\n                  \"code\": 0,\n                  \"msg\": \"The order was cancelled successfully.\"\n                }\n              },\n              \"2\": {\n                \"summary\": \"Exception\",\n                \"value\": {\n                  \"code\": -1,\n                  \"msg\": \"Order cancellation failed. Please try again later.\",\n                  \"errCode\": \"500.041.006\"\n                }\n              }\n            }\n          }\n        },\n        \"headers\": {}\n      }\n    },\n    \"security\": [\n      {\n        \"jwt\": []\n      }\n    ]\n  }\n}"